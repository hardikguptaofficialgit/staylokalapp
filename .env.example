# Copy to .env.local and fill in values. Never commit .env.local.

# Public site origin (checkout returns, email links)
NEXT_PUBLIC_APP_URL=https://staylokal.app

# Dodo Payments — use live_mode in production; product IDs must match that environment
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=live_mode
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_DONATION_PRODUCT_ID=
DODO_SPONSOR_PRODUCT_ID=
# Dodo appends payment_id (and status) on redirect; do not use ?success=1 alone
DODO_PAYMENTS_RETURN_URL=https://staylokal.app/donate
DODO_SPONSOR_RETURN_URL=https://staylokal.app/?sponsor=success

# Appwrite (VelocityBrain / StayLokal TablesDB)
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_SPONSORS_TABLE_ID=staylokal_sponsors
APPWRITE_CLAIMS_TABLE_ID=staylokal_claims
APPWRITE_SPONSOR_BUCKET_ID=staylokal_sponsor_logos
APPWRITE_MESSAGING_EMAIL_PROVIDER_ID=

# Optional email branding
# SPONSOR_EMAIL_ASSET_BASE_URL=
# SPONSOR_EMAIL_LOGO_URL=
