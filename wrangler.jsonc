{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "a4ad01d39f86f127a5dddee41cf7bc5f",
	"main": ".open-next/worker.js",
	"name": "staylokalapp",
	"compatibility_date": "2026-09-15",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "RUNTIME_ASSETS",
			"bucket_name": "staylokal-runtime-assets"
		}
	],
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "staylokalapp"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"vars": {
		"NEXT_PUBLIC_APP_URL": "https://staylokal.app",
		"NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN": "cc4ed9110bb844858a8bff04f101127d",
		"APPWRITE_ENDPOINT": "https://fra.cloud.appwrite.io/v1",
		"APPWRITE_PROJECT_ID": "69e7d0a0002573ec6840",
		"APPWRITE_DATABASE_ID": "6aa918ed001e3dd5a377",
		"APPWRITE_SPONSORS_TABLE_ID": "staylokal_sponsors",
		"APPWRITE_CLAIMS_TABLE_ID": "staylokal_claims",
		"APPWRITE_SPONSOR_BUCKET_ID": "staylokal_sponsor_logos",
		"APPWRITE_MESSAGING_EMAIL_PROVIDER_ID": "6ab54ac3003bfb09a711"
	},
	"routes": [
		{
			"pattern": "staylokal.app",
			"custom_domain": true
		},
		{
			"pattern": "www.staylokal.app",
			"custom_domain": true
		}
	]
}